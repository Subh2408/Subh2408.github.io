---
/**
 * Stack / domain / method chips. Each one links into the project list filtered
 * to that value, which works because /work indexes chip values alongside the
 * two filter axes.
 */
import { url } from "../lib/paths";

interface Props {
  chips: Record<string, string[]>;
}
const { chips } = Astro.props;
const entries = Object.entries(chips ?? {}).filter(([, v]) => v.length > 0);
---

{
  entries.length > 0 && (
    <div class="chips">
      {entries.map(([key, values]) => (
        <div class="chiprow">
          <span class="chipkey">{key}</span>
          <span class="chipvals">
            {values.map((v) => (
              <a class="chip" href={url(`/work?filter=${encodeURIComponent(v)}`)}>
                {v}
              </a>
            ))}
          </span>
        </div>
      ))}
    </div>
  )
}
