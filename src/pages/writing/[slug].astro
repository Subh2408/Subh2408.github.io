---
/**
 * One post. The module, where a post has one, sits above the body: it is the
 * strongest thing on the page and should not be at the end of a ten-minute
 * read. The body is the author's prose and is rendered as written.
 */
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import WorkModule from "../../components/WorkModule.astro";
import { getCollection, render } from "astro:content";
import { publishedPosts, POST_MODULE_SLUGS } from "../../lib/content";
import { longDate, isoDay } from "../../lib/dates";
import { url } from "../../lib/paths";
import { SITE } from "../../lib/site";
import { article, breadcrumbList } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const ordered = await publishedPosts();
const index = ordered.findIndex((p) => p.id === entry.id);
const newer = index > 0 ? ordered[index - 1] : undefined;
const older = index < ordered.length - 1 ? ordered[index + 1] : undefined;

const origin = Astro.site ?? new URL("http://localhost:4321");
const jsonLd = [
  article(origin, entry),
  breadcrumbList(origin, [
    { label: "Home", path: "/" },
    { label: "Writing", path: "/writing" },
    { label: entry.data.title, path: `/writing/${entry.id}` },
  ]),
];
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  nav="writing"
  ogType="article"
  ogImage={`/og/post-${entry.id}.png`}
  jsonLd={jsonLd}
>
  <article class="page">
    <Crumbs
      items={[
        { label: "Home", href: url("/") },
        { label: "Writing", href: url("/writing") },
        { label: entry.data.title },
      ]}
    />

    <h1 class="display" style="margin-top:16px;max-width:24ch">{entry.data.title}</h1>

    <div class="metarow" style="margin-top:18px">
      <span class="meta">{SITE.locality}</span>
      <span class="meta-mono">
        <time datetime={isoDay(entry.data.date)}>{longDate(entry.data.date)}</time>
      </span>
      {entry.data.readTime && <span class="meta-mono">{entry.data.readTime}</span>}
      {POST_MODULE_SLUGS.has(entry.id) && <span class="livechip">&#9679; runs here</span>}
    </div>

    <div class="chips" style="margin-top:18px">
      <div class="chipvals">
        {
          entry.data.tags.map((t) => (
            <a class="pill sm" href={url(`/writing?tag=${encodeURIComponent(t)}`)}>
              {t}
            </a>
          ))
        }
      </div>
    </div>

    <div style="margin-top:30px">
      <WorkModule slug={entry.id} />
    </div>

    <div class="prose" style="margin-top:30px;max-width:66ch">
      <Content />
    </div>

    <nav class="pager" aria-label="More writing">
      {
        newer && (
          <a class="pager-btn" href={url(`/writing/${newer.id}`)}>
            <span class="pager-k">&larr; Newer</span>
            <span>{newer.data.title}</span>
          </a>
        )
      }
      {
        older && (
          <a class="pager-btn right" href={url(`/writing/${older.id}`)}>
            <span class="pager-k">Older &rarr;</span>
            <span>{older.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
