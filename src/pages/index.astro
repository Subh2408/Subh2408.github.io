---
/**
 * Home. Single-page scroll: hero, proof, Approach, Selected work, Close.
 * The footer appears here and nowhere else.
 *
 * Shape matters on this page. No two adjacent sections share a form: a split
 * hero with a working module, a ruled ledger of numbers on ink, an editorial
 * list on white, an asymmetric pair on grey, a dark closing band. The earlier
 * version stacked four identical card grids under numbered eyebrows, which
 * read as a slide deck.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import CopyEmail from "../components/CopyEmail.astro";
import ClaimsThreshold from "../components/modules/ClaimsThreshold";
import { allWork, positionsByRecency, positionMap, WORK_MODULE_SLUGS } from "../lib/content";
import { year } from "../lib/dates";
import { url } from "../lib/paths";
import { SITE, POSITIONING, SUBLINE, APPROACH, PAGE_META, SKILLS } from "../lib/site";
import { HIGHLIGHTS } from "../lib/highlights";
import { person } from "../lib/schema";
import { INDUSTRIES } from "../lib/taxonomy";
import { Image } from "astro:assets";

// Pulled through astro:assets so the build emits small, hashed derivatives.
// The originals are 2.0-2.6MB and would be ruinous on a phone.
import tile1 from "../../public/images/tiles/tile-01.png";
import tile2 from "../../public/images/tiles/tile-02.png";
import tile3 from "../../public/images/tiles/tile-03.png";

const work = await allWork();
const positions = await positionsByRecency();
const byPosition = await positionMap();

/**
 * The three featured on the home page are chosen, not derived. Eight entries
 * carry `featured: true`, and these three are the ones with a working module,
 * which is the point the section is making. The first is the lead.
 */
const FEATURED = ["qic-risk-operations-tool", "claims-adjudication", "sku-optimization"];
const featured = FEATURED.map((slug) => work.find((w) => w.id === slug)).filter(
  (w): w is NonNullable<typeof w> => Boolean(w)
);
const [lead, ...rest] = featured;

/**
 * The mobile tile grid. Five real figures as coloured tiles, three
 * graphics, interleaved so colour and image alternate. The graphics are
 * decoration, not links; tapping one shows a short overlay (see the script
 * at the end of this file).
 *
 * Grounds are the four --tile-* tokens, mobile only. The order keeps blue
 * and coral from ever touching themselves once the graphics are in place.
 * White text clears 4.5:1 on all four (19.80, 7.34, 5.86, 5.11); the small
 * label sits at 92%, because 80% fails on blue and coral.
 */
const TILES = [
  { kind: "kpi", tone: "t-coral", n: "$5M+", label: "SKU optimisation", slug: "sku-optimization" },
  { kind: "graphic", img: tile1 },
  { kind: "kpi", tone: "t-blue", n: "15 hrs → ~15 min", long: true, label: "Claims adjudication", slug: "claims-adjudication" },
  { kind: "kpi", tone: "t-black", n: "QCB", label: "AI governance", slug: "qic-ai-governance-qcb" },
  { kind: "graphic", img: tile2 },
  { kind: "kpi", tone: "t-grey", n: "5 teams", label: "Risk operations tool", slug: "qic-risk-operations-tool" },
  { kind: "kpi", tone: "t-blue", n: "$2.5M", label: "Semiconductor MLOps", slug: "semiconductor-defect-detection" },
  { kind: "graphic", img: tile3 },
] as const;

/** Stats row on the profile block. Derived, not hand-typed. */
const YEARS = new Date().getFullYear() - 2015;
// Read from the taxonomy, so the number cannot drift from what /work filters by.
const INDUSTRY_COUNT = INDUSTRIES.length;

const origin = Astro.site ?? new URL("http://localhost:4321");
const jsonLd = [person(origin, positions, [...SKILLS])];
---

<Base
  title={PAGE_META.home.title}
  description={PAGE_META.home.description}
  exactTitle
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-rise hero-say">
      <h1 class="display-l">{POSITIONING}</h1>
      <p class="subline">{SUBLINE}</p>
      <p class="subline-m">AI strategy, product and delivery. {SITE.locality}, {SITE.country}.</p>

      {/* Thin dividers rather than middots: three dot-separated items is a
          tell, and the audit fails the build over it. */}
      <div class="profstats">
        <span>{work.length} projects</span>
        <span>{YEARS} yrs</span>
        <span>{INDUSTRY_COUNT} industries</span>
      </div>

      <div class="statusline">
        <span class="st-where">
          <span class="dot" aria-hidden="true"></span>
          <span>{SITE.locality}, {SITE.country}</span>
        </span>
        <span class="clock" data-clock>--:-- {SITE.utcOffset}</span>
        <span class="st-open">Open to conversations</span>
      </div>

      <div class="herocta">
        <a class="btn solid" href={url("/work")}>See the work</a>
        <CopyEmail />
      </div>
    </div>

    <div class="hero-rise-2 hero-demo">
      <p class="demo-cue">Move the slider. This is the model from a real project.</p>
      <ClaimsThreshold client:media="(min-width: 820px)" compact />
      <a class="demo-link" href={url("/work/claims-adjudication")}>Read the case study &rarr;</a>
    </div>
  </section>

  {/* Mobile only. The visual centrepiece of the phone home page. */}
  <section class="tiles" aria-label="Highlights">
    {
      TILES.map((t) =>
        t.kind === "kpi" ? (
          <a class:list={["tile", t.tone]} href={url(`/work/${t.slug}`)}>
            <span class:list={["tile-n", t.long && "long"]}>{t.n}</span>
            <span class="tile-l">{t.label}</span>
          </a>
        ) : (
          <div class="tile tile-g" aria-hidden="true">
            <Image src={t.img} alt="" width={420} height={420} loading="lazy" />
            <span class="tile-msg">Made you wonder, didn't I?</span>
          </div>
        )
      )
    }
  </section>

  <section class="proof" aria-label="Selected results">
    <ul class="prooflist">
      {
        HIGHLIGHTS.map((h) => (
          <li class="proofrow">
            <a href={url(`/work/${h.slug}`)}>
              <span class:list={["pnum", h.number.length > 8 && "long"]}>{h.number}</span>
              <span class="plabel">{h.label}</span>
              <span class="pctx">{h.context}</span>
            </a>
          </li>
        ))
      }
    </ul>

  </section>

  <section id="approach" class="band warm">
    <div class="splitband">
      <div class="splitband-head">
        <h2 class="h2">How I work.</h2>
      </div>
      <ol class="approachlist">
        {
          APPROACH.map((a, i) => (
            <li class="approachitem">
              <span class="anum" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <details class="apx">
                <summary>
                  <h3>{a.k}</h3>
                  <p class="apxv">{a.v}</p>
                </summary>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="featured" class="band cool">
    <div class="bandhead">
      <h2 class="h2">Selected work.</h2>
      <a class="btn" href={url("/work")}>All {work.length} projects &rarr;</a>
    </div>
    <div class="workband">
      {
        lead && (
          <a class="leadcard" href={url(`/work/${lead.id}`)}>
            <span class="ftitle">{lead.data.title}</span>
            <span class="fmeta">
              <span>{byPosition.get(lead.data.position)?.data.company}</span>
              <span class="yr">{year(lead.data.date)}</span>
            </span>
            <span class="fkpis">
              {lead.data.kpis.map((k) => (
                <span>
                  <b>{k.value}</b>
                  {k.label}
                </span>
              ))}
            </span>
            {WORK_MODULE_SLUGS.has(lead.id) && <span class="livechip">&#9679; playable</span>}
          </a>
        )
      }
      <div class="worksub">
        {
          rest.map((w) => (
            <a class="worksubrow" href={url(`/work/${w.id}`)}>
              <span class="ftitle">{w.data.title}</span>
              <span class="fmeta">
                <span>{byPosition.get(w.data.position)?.data.company}</span>
                <span class="yr">{year(w.data.date)}</span>
              </span>
              <span class="fkpis inline">
                {w.data.kpis.slice(0, 2).map((k) => (
                  <span>
                    <b>{k.value}</b>
                    {k.label}
                  </span>
                ))}
              </span>
              {WORK_MODULE_SLUGS.has(w.id) && <span class="livechip">&#9679; playable</span>}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band dark close">
    <h2 class="h2 closehead">Get in touch.</h2>
    <div class="contactrow">
      <CopyEmail dark />
      <a class="cmeta ul" href={`tel:${SITE.phone.replace(/\s/g, "")}`}>{SITE.phone}</a>
      <span class="cmeta clock">
        {SITE.locality}, <span data-clock>--:-- {SITE.utcOffset}</span>
      </span>
      <a class="btn ghost" href={url("/resume")}>Résumé</a>
    </div>
  </section>

  <Footer />
</Base>

<script>
  // Local time in Doha, so a caller knows whether it is a reasonable hour.
  // Server-rendered as "--:--" at the same width, so nothing shifts.
  function paintClock() {
    const nodes = document.querySelectorAll<HTMLElement>("[data-clock]");
    if (!nodes.length) return;
    let time: string;
    try {
      time = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Qatar",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(new Date());
    } catch {
      return; // Timezone data unavailable. Leave the placeholder.
    }
    nodes.forEach((n) => {
      n.textContent = `${time} GMT+3`;
    });
  }

  let timer: number | undefined;
  function startClock() {
    paintClock();
    window.clearInterval(timer);
    timer = window.setInterval(paintClock, 20000);
  }
  startClock();
  document.addEventListener("astro:page-load", startClock);

  // Graphic tiles: a tap shows the overlay, which clears itself after 2.5s
  // or on a second tap. Each tile keeps its own timer, so they never
  // interfere with each other.
  function bindTiles() {
    document.querySelectorAll<HTMLElement>(".tile-g").forEach((tile) => {
      if (tile.dataset.bound === "1") return;
      tile.dataset.bound = "1";
      let hideTimer: number | undefined;
      const hide = () => {
        window.clearTimeout(hideTimer);
        tile.classList.remove("is-on");
      };
      tile.addEventListener("click", () => {
        if (tile.classList.contains("is-on")) {
          hide();
          return;
        }
        tile.classList.add("is-on");
        hideTimer = window.setTimeout(hide, 2500);
      });
    });
  }
  bindTiles();
  document.addEventListener("astro:page-load", bindTiles);

</script>
